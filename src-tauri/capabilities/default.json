{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: file dialogs, opening the preview window, the app's own read/write commands, handing tel:, mailto: and web links to the system, and the two GitHub sign-in endpoints that do not allow browser requests",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://github.com/login/device/code"
        },
        {
          "url": "https://github.com/login/oauth/access_token"
        }
      ]
    }
  ]
}
